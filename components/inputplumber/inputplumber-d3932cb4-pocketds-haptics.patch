+const MIN_PULSE_DURATION_MS: u32 = 5;
+const MAX_PULSE_DURATION_MS: u32 = 50;
+
+fn bounded_pulse(value: f64, duration_ms: u32) -> (f64, Duration) {
+    let value = if value.is_finite() {
+        value.clamp(0.0, MAX_PULSE_VALUE)
+    } else {
+        0.0
+    };
+    let duration_ms = duration_ms.clamp(MIN_PULSE_DURATION_MS, MAX_PULSE_DURATION_MS);
+    (value, Duration::from_millis(duration_ms.into()))
+}
