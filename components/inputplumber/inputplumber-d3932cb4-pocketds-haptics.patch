+    /// Send one short, bounded rumble pulse and always stop it before returning.
+    async fn pulse(
+        &mut self,
+        value: f64,
+        duration_ms: u32,
+        #[zbus(connection)] conn: &Connection,
+        #[zbus(header)] hdr: Header<'_>,
+    ) -> fdo::Result<()> {
+        check_polkit(conn, Some(hdr), "org.shadowblip.Output.ForceFeedback.Pulse").await?;
+
+        let (value, duration) = bounded_pulse(value, duration_ms);
+        let rumble_error = self
+            .device
+            .rumble(value)
+            .await
+            .err()
+            .map(|err| err.to_string());
+        if let Some(message) = rumble_error {
+            let _ = self.device.stop().await;
+            return Err(fdo::Error::Failed(message));
+        }
+        tokio::time::sleep(duration).await;
+        self.device
+            .stop()
+            .await
+            .map_err(|err| fdo::Error::Failed(err.to_string()))?;
+        Ok(())
+    }
