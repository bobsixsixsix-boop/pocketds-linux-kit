# /etc/udev/rules.d/60-pocketds-i2c-ddc.rules
#
# Fedora's /usr/lib/udev/rules.d/60-ddcutil-i2c.rules grants logind
# uaccess (active-user ACL) to i2c-dev nodes whose parent device has
# PCI class 0x030000 (Display Controller). On the Pocket DS / SM8550
# the DisplayPort controller is a platform DT node, not a PCI device,
# so that rule never matches and PowerDevil logs EACCES on every
# /dev/i2c-* at startup while scanning DDC for external-monitor
# brightness control.
#
# Match the DP controller's DDC bus via the DT OF_NAME and tag it
# uaccess so the active graphical user can talk DDC/CI to a monitor
# plugged in over USB-C/DP.
#
# Deliberately scoped to the DP controller: the other i2c buses
# (i2c-0..3, the SoC GENI QUP buses) carry sensors / MCU / codec /
# touch traffic and must NOT be exposed to userspace. PowerDevil's
# DDC scan is unfiltered so it will still log EACCES once at startup
# for those — that's a PowerDevil-side issue, not a permissions bug.

SUBSYSTEM=="i2c-dev", KERNEL=="i2c-[0-9]*", DRIVERS=="msm-dp-display", TAG+="uaccess"
