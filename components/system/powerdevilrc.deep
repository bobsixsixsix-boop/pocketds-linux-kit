# Native KDE/logind daily deep sleep; opt-in guarded to the verified v3 kernel.
# Display-off remains available before the longer sleep deadline.
[AC][Display]
DimDisplayWhenIdle=false
LockBeforeTurnOffDisplay=false
TurnOffDisplayIdleTimeoutSec=300
TurnOffDisplayIdleTimeoutWhenLockedSec=60
TurnOffDisplayWhenIdle=true
UseProfileSpecificDisplayBrightness=false

[AC][SuspendAndShutdown]
AutoSuspendAction=1
AutoSuspendIdleTimeoutSec=600
SleepMode=1
InhibitLidActionWhenExternalMonitorPresent=false
LidAction=1
PowerButtonAction=1
PowerDownAction=0

[Battery][Display]
DimDisplayWhenIdle=false
LockBeforeTurnOffDisplay=false
TurnOffDisplayIdleTimeoutSec=300
TurnOffDisplayIdleTimeoutWhenLockedSec=60
TurnOffDisplayWhenIdle=true
UseProfileSpecificDisplayBrightness=false

[Battery][SuspendAndShutdown]
AutoSuspendAction=1
AutoSuspendIdleTimeoutSec=600
SleepMode=1
InhibitLidActionWhenExternalMonitorPresent=false
LidAction=1
PowerButtonAction=1
PowerDownAction=0

[LowBattery][Display]
DimDisplayWhenIdle=false
LockBeforeTurnOffDisplay=false
TurnOffDisplayIdleTimeoutSec=120
TurnOffDisplayIdleTimeoutWhenLockedSec=60
TurnOffDisplayWhenIdle=true
UseProfileSpecificDisplayBrightness=false

[LowBattery][SuspendAndShutdown]
AutoSuspendAction=1
AutoSuspendIdleTimeoutSec=180
SleepMode=1
InhibitLidActionWhenExternalMonitorPresent=false
LidAction=1
PowerButtonAction=1
PowerDownAction=0
