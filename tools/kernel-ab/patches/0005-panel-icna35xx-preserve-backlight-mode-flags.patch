From: Pocket DS Linux maintenance
Subject: [PATCH] drm/panel: icna35xx: restore mode flags after brightness I/O

The brightness callbacks temporarily clear MIPI_DSI_MODE_LPM. A failed
transfer returns before restoring it, leaving later panel commands in a
different transfer mode. Successful calls also unconditionally set LPM,
even if it was clear on entry.

Save the incoming flags and restore them immediately after the transfer,
before checking its result. Preserve the existing brightness transfer mode
and return values.

This candidate does not serialize brightness I/O with panel power changes
or other mode_flags writers, and does not make actual_brightness a passive
read. It has not been compiled or accepted by physical lid/suspend tests.

--- a/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
+++ b/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
@@ -488,33 +488,33 @@
 static int icna35xx_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	unsigned long mode_flags = dsi->mode_flags;
 	u16 brightness = backlight_get_brightness(bl);
 	int ret;
 
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
 	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	dsi->mode_flags = mode_flags;
 	if (ret < 0)
 		return ret;
 
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
-
 	return 0;
 }
 
 static int icna35xx_bl_get_brightness(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	unsigned long mode_flags = dsi->mode_flags;
 	u16 brightness;
 	int ret;
 
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
 	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
+	dsi->mode_flags = mode_flags;
 	if (ret < 0)
 		return ret;
-
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
 	return brightness;
 }
