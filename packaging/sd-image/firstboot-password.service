[Unit]
Description=Set the Pocket DS password once on first use
ConditionPathExists=/var/lib/pocketds-firstboot/pending
After=local-fs.target
Before=display-manager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/libexec/pocketds-firstboot-server.py
RuntimeDirectory=pocketds-firstboot
RuntimeDirectoryMode=0755
UMask=0077
LimitCORE=0
Restart=on-failure
RestartSec=5
StandardOutput=null
StandardError=null
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
